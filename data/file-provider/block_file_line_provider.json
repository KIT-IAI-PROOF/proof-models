{
  "id": "block_file_line_provider",
  "name": "File Line Provider",
  "description": "provide the Workflow with lines from a given file",
  "inputs": [
    {
      "name": "file_name",
      "type": "string",
      "phase": "INIT",
      "eventId": 0,
      "required": true,
      "communicationType": "STEPBASED_STATIC",
      "metadata": {}
    },
    {
      "name": "num_steps",
      "type": "integer",
      "phase": "INIT",
      "eventId": 0,
      "required": false,
      "communicationType": "STEPBASED_STATIC",
      "metadata": {}
    },
    {
      "name": "ignore_first_line",
      "type": "string",
      "phase": "INIT",
      "eventId": 1,
      "required": false,
      "communicationType": "STEPBASED_STATIC",
      "metadata": {}
    }
  ],
  "outputs": [
    {
      "name": "line",
      "type": "string",
      "phase": "EXECUTE",
      "eventId": 1,
      "communicationType": "STEPBASED",
      "metadata": {}
    }
  ],
  "containerImage": "iai-artifactory.iai.kit.edu/docker-webis/proof-2/proof-standard:latest",
  "communicationParadigm": "STEPBASED",
  "programId": "prog_file_line_provider",
  "startParameters": {},
  "eventLifeCycles": [],
  "blockIODefinitions": [
    {
      "phase": "INIT",
      "input": {
        "type": "STDIO",
        "parameters": {
          "mapping": {
            "file_name": "file_name",
            "num_steps": "num_steps",
            "ignore_first_line": "ignore_first_line"
          }
        }
      }
    },
    {
      "phase": "EXECUTE",
      "input": {},
      "output": {
        "type": "STDIO",
        "parameters": {
          "mapping": {
            "line": "line"
          }
        }
      }
    },
    {
      "phase": "FINALIZE",
      "input": {
        "type": "STDIO",
        "parameters": {
          "mapping": {
          }
        }
      },
      "output": {
        "type": "STDIO",
        "parameters": {
          "mapping": {
          }
        }
      }
    }
  ]
}
